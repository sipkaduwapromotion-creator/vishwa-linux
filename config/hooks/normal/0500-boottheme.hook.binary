#!/bin/sh
#
# Vishwa Linux - bootloader theming hook (binary stage).
#
# NOTE: live-build runs local binary hooks from the build root, with the ISO
# tree in "binary/". Normalise that so everything below is relative to the ISO
# root.
set -e

if [ -d binary ]; then
	cd binary
fi

echo "Vishwa: theming bootloaders..."
echo "Vishwa: ISO tree directories:"
find . -maxdepth 2 -type d 2>/dev/null | sort | sed 's/^/  /' || true

# ---- syslinux / isolinux (BIOS boot) ----------------------------------------
if [ -d isolinux ]; then
	if [ -f vishwa-boot/syslinux-splash.png ]; then
		cp -f vishwa-boot/syslinux-splash.png isolinux/splash.png
	fi
	if [ -f vishwa-boot/stdmenu.cfg ]; then
		cp -f vishwa-boot/stdmenu.cfg isolinux/stdmenu.cfg
	fi
	if [ -f isolinux/menu.cfg ]; then
		sed -i 's/^menu title .*/menu title Vishwa Linux 1.0 (Cosmos)/' isolinux/menu.cfg || true
	fi
	echo "Vishwa: syslinux themed."
else
	echo "Vishwa: no isolinux dir found."
fi

# ---- GRUB (UEFI boot) -------------------------------------------------------
GRUB_DIR=""
for d in boot/grub EFI/BOOT/grub EFI/boot/grub boot/grub2 EFI/debian/grub; do
	if [ -d "$d" ]; then
		GRUB_DIR="$d"
		break
	fi
done

if [ -n "$GRUB_DIR" ]; then
	if [ -f vishwa-boot/grub-splash.png ]; then
		cp -f vishwa-boot/grub-splash.png "$GRUB_DIR/splash.png"
	fi
	if [ -f vishwa-boot/grub-theme.txt ]; then
		mkdir -p "$GRUB_DIR/live-theme"
		cp -f vishwa-boot/grub-theme.txt "$GRUB_DIR/live-theme/theme.txt"
	fi
	echo "Vishwa: grub themed ($GRUB_DIR)."
else
	echo "Vishwa: no grub dir found."
fi

# ---- staging cleanup --------------------------------------------------------
rm -rf vishwa-boot

exit 0
