# Vishwa Linux - Plymouth boot theme (cosmic)
# Based on the stock plymouth "script" example theme.

Window.SetBackgroundTopColor (0.043, 0.027, 0.113);
Window.SetBackgroundBottomColor (0.008, 0.004, 0.031);

logo.image = Image ("logo.png");
logo.sprite = Sprite (logo.image);
logo.opacity_angle = 0;

fun refresh_callback ()
  {
    logo.opacity_angle += ((2 * 3.14159) / 50) * 0.4;
    min_opacity = 0.45;
    opacity = (Math.Cos (logo.opacity_angle) + 1) / 2;
    opacity *= 1 - min_opacity;
    opacity += min_opacity;

    logo.sprite.SetX (Window.GetX () + Window.GetWidth () / 2 - logo.image.GetWidth () / 2);
    logo.sprite.SetY (Window.GetY () + Window.GetHeight () / 2 - logo.image.GetHeight () / 2);
    logo.sprite.SetOpacity (opacity);
  }

Plymouth.SetRefreshFunction (refresh_callback);
